# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "Slice"
  Version: "2.2"

Environment:
  WorldSettings:
    GameModeClass: "ALeonHorrorGameMode"
    StaticLighting: true
    LightingBuildQuality: Draft
    LightmapResolution: 64
    NumIndirectBounces: 2
    SamplesPerTexel: 8
    IndirectIntensity: 1
    AmbientOcclusion: true
    AOIntensity: 1
    AORadius: 1
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/Slice.llightmap"
    LightmapBakeHash: "26940dff2ae78c35"
  Skybox:
    Enabled: true
    Exposure: 0.9
    SunIntensity: 0
    EnvironmentIntensity: 0.6
    UseHDREnvironmentMap: false
    HDREnvironmentMap: ""
    SkyZenithColor: [0.03, 0.034, 0.042]
    HorizonColor: [0.04, 0.042, 0.048]
    GroundColor: [0.02, 0.02, 0.024]
    SunColor: [0.3, 0.32, 0.4]
    FogEnabled: true
    FogColor: [0.03, 0.034, 0.038]
    FogDensity: 0.05
    FogStartDistance: 2.5
    FogHeightFalloff: 0
    FogBaseHeight: 0
    FogMaxOpacity: 0.92

